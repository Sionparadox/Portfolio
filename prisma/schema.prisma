generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectDetailType {
  contribution
  insight
}


model Project {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  overview      String    @db.Text
  description   String    @db.Text
  category      String    // Web, Mobile등 구분
  thumbnail     String
  icon          String
  
  techStack     String[]
  teamSize      Int       @default(1)
  role          String?
  
  startDate     DateTime
  endDate       DateTime?
  
  github        String?
  link          String?
  
  featured      Boolean   @default(false)
  order         Int       @default(0)

  details       ProjectDetail[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ProjectDetail {
  id          String            @id @default(cuid())
  projectId   String
  type        ProjectDetailType
  title       String
  link        String?
  description String            @db.Text
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type, order])
}


model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}


model Timeline {
  id           String   @id @default(cuid())
  type         String   // 'experience', 'education', 'certifications'
  date         String   
  year         String   
  place        String   
  title        String   
  descriptions String[]
  image        String   // 이미지 경로 (예: "/img/timeline/school.png")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}